{
  "name": "queue-kit-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified TypeScript queues across providers, without sacrificing native provider power.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.enabled=true",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint packages examples",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"examples/**/*.ts\"",
    "bun:smoke": "bun examples/memory-basic.ts",
    "clean": "pnpm -r exec rm -rf dist",
    "release:check": "bash scripts/release-check.sh",
    "release": "bash scripts/release.sh",
    "release:check:core": "PKG=core bash scripts/release-check.sh",
    "release:check:memory": "PKG=memory bash scripts/release-check.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.1.11"
  }
}
