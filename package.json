{
  "name": "@mohamedhabibwork/queuekit",
  "version": "0.1.0",
  "description": "Runtime-neutral TypeScript queues, messaging, pub/sub, and streams without losing provider-native types.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./kafka": { "types": "./dist/kafka.d.ts", "import": "./dist/kafka.js" },
    "./rabbitmq": { "types": "./dist/rabbitmq.d.ts", "import": "./dist/rabbitmq.js" },
    "./bullmq": { "types": "./dist/bullmq.d.ts", "import": "./dist/bullmq.js" },
    "./redis": { "types": "./dist/redis.d.ts", "import": "./dist/redis.js" },
    "./nats": { "types": "./dist/nats.d.ts", "import": "./dist/nats.js" },
    "./sqs": { "types": "./dist/sqs.d.ts", "import": "./dist/sqs.js" },
    "./custom": { "types": "./dist/custom.d.ts", "import": "./dist/custom.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.typecheck.json --noEmit",
    "check": "npm run build && npm run test && npm run test:types",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run clean && npm run check"
  },
  "keywords": ["queue", "messaging", "kafka", "rabbitmq", "bullmq", "redis", "nats", "sqs", "typescript", "deno", "bun"],
  "author": "Mohamed Habib",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/mohamedhabibwork/queuekit.git" },
  "bugs": { "url": "https://github.com/mohamedhabibwork/queuekit/issues" },
  "homepage": "https://mohamedhabibwork.github.io/queuekit/",
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.1128.0",
    "amqplib": "^0.10.9",
    "bullmq": "^6.3.4",
    "kafkajs": "^2.2.4",
    "nats": "^2.29.3",
    "redis": "^6.2.1"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sqs": { "optional": true },
    "amqplib": { "optional": true },
    "bullmq": { "optional": true },
    "kafkajs": { "optional": true },
    "nats": { "optional": true },
    "redis": { "optional": true }
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1128.0",
    "@types/amqplib": "^0.10.7",
    "amqplib": "^0.10.9",
    "bullmq": "^6.3.4",
    "kafkajs": "^2.2.4",
    "nats": "^2.29.3",
    "redis": "^6.2.1",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
