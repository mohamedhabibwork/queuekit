{
  "name": "@queue-kit/memory",
  "version": "0.1.0",
  "description": "In-memory Queue Kit provider for tests, examples and local development. Deterministic with FakeClock.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "queue",
    "queue-kit",
    "memory",
    "testing",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@queue-kit/core": "workspace:^"
  },
  "devDependencies": {
    "@queue-kit/core": "workspace:^",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
